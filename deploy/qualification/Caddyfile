{$EVALDIFF_STAGING_HOST} {
	@operations path /ops /ops/*
	respond @operations 404
	reverse_proxy api:8000
	encode zstd gzip
	header {
		X-Evaldiff-Staging-Project {$EVALDIFF_STAGING_PROJECT}
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}
